const int ldrPin = A0;
const int ledPin = 9;
const int threshold = 400;

void setup() {
  pinMode(ledPin, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  int lightValue = analogRead(ldrPin);

  Serial.println(lightValue);

  if (lightValue < threshold) {
    digitalWrite(ledPin, HIGH);  // Light ON
  } else {
    digitalWrite(ledPin, LOW);   // Light OFF
  }

  delay(500);
}
